# Streamlit Cloud では Manage app → Settings → Secrets にこれと同じ形式で貼り付ける。
# ローカル開発時は `secrets/` ディレクトリ・ADCファイルから自動読み込みされるので、
# このファイルをコピーする必要はない。

# ─── サービスアカウントキー (Sheets API 用) ────────────────────────
# secrets/dashboard-bq-key.json の中身を以下にコピー。
[gcp_service_account]
type = "service_account"
project_id = "trustline-project"
private_key_id = "..."
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "dashboard-bq@trustline-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"

# ─── ユーザー ADC 認証 (BigQuery クエリ用) ─────────────────────────
# %APPDATA%\gcloud\application_default_credentials.json の中身を以下にコピー。
# Drive スコープが Workspace でブロックされているため、本番では
# SA を使わずユーザーADCで BQ クエリを発行する構成です。
[gcp_user_credentials]
type = "authorized_user"
client_id = "..."
client_secret = "..."
refresh_token = "..."
quota_project_id = "trustline-project"
universe_domain = "googleapis.com"
